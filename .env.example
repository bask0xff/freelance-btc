# --- bitcoind RPC (ваша существующая нода, prune mode) ---
BTC_RPC_HOST=host.docker.internal
BTC_RPC_PORT=8332
BTC_RPC_USER=btcuser
BTC_RPC_PASSWORD=change_me
# Пароль шифрования кошелька (как walletpassphrase в вашем скрипте).
# Используется backend'ом ТОЛЬКО в момент отправки средств (release эскроу), затем кошелёк сразу блокируется обратно.
BTC_WALLET_PASSPHRASE=change_me
# Сколько подтверждений нужно, чтобы считать платёж окончательным
BTC_MIN_CONFIRMATIONS=2

# --- MySQL ---
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=freelance_btc

HTTP_PORT=8080

# --- JWT ---
# Сгенерируйте случайную строку, например: openssl rand -hex 32
JWT_SECRET=change_me_to_random_string
JWT_TTL_MINUTES=10080
